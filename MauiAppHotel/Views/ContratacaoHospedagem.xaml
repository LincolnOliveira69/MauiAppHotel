<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <!-- Grid com duas camadas: conteúdo principal + botão fixo -->
    <Grid>
        <!-- Camada 1: conteúdo principal -->
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="20">

                <Label Text="Cálculo da Diária" 
                       FontFamily="Kalam"
                       FontSize="50"
                       TextColor="{StaticResource Primary}"/>

                <Frame Padding="10">
                    <VerticalStackLayout>

                        <Grid RowDefinitions="Auto, Auto"
                              ColumnDefinitions="*, *, 2*">

                            <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" 
                                   FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" 
                                   TextColor="{StaticResource Primary}"
                                   Text="{Binding Value}" 
                                   BindingContext="{x:Reference stp_adultos}" />
                            <Stepper Grid.Row="0" Grid.Column="2"
                                     x:Name="stp_adultos"
                                     Minimum="0" Maximum="10" Increment="1" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" 
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   TextColor="{StaticResource Primary}"
                                   Text="{Binding Value}" 
                                   BindingContext="{x:Reference stp_criancas}" />
                            <Stepper Grid.Row="1" Grid.Column="2"
                                     x:Name="stp_criancas"
                                     Minimum="0" Maximum="10" Increment="1" />
                        </Grid>

                        <Label Text="Escolha sua Suíte" 
                               FontAttributes="Bold" />
                        <Picker x:Name="pck_quarto" 
                                Title="Selecione sua Acomodação" 
                                ItemDisplayBinding="{Binding Descricao}"/>

                        <Frame Padding="10" Margin="10">
                            <VerticalStackLayout>
                                <Label Text="Período da Estadia"
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" />
                                <HorizontalStackLayout>
                                    <Label Text="Check-in:" 
                                           FontAttributes="Bold" />
                                    <DatePicker x:Name="dtpck_checkin" 
                                                DateSelected="dtpck_checkin_DateSelected"
                                                Format="dd/MM/yyyy" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout>
                                    <Label Text="Check-out:" 
                                            FontAttributes="Bold" />
                                    <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>

                        <Button Text="Avançar" Clicked="Button_Clicked" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Camada 2: botão "Sobre" fixo no canto inferior direito -->
        <Label Text="Sobre"
               TextColor="{StaticResource Primary}"
               FontSize="18"
               FontAttributes="Bold"
               Margin="10"
               HorizontalOptions="End"
               VerticalOptions="End">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSobreTapped" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentPage>