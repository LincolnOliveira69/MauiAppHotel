<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="{Binding Suite}" 
               TextColor="{StaticResource Primary}"
               FontFamily="Kalam"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Frame Margin="10">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="30">

                <!-- Adultos -->
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="Número de Adultos:"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Adultos}"
                   TextColor="{StaticResource Primary}"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ValorDiariaAdulto, StringFormat='R$ {0:N2}'}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="DarkGray" />
                    <Label Text="Valor por adulto/dia"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />
                </VerticalStackLayout>

                <!-- Crianças -->
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="Número de Crianças:"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Criancas}"
                   TextColor="{StaticResource Primary}"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ValorDiariaCrianca, StringFormat='R$ {0:N2}'}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="DarkGray" />
                    <Label Text="Valor por criança/dia"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray" />
                </VerticalStackLayout>

            </HorizontalStackLayout>
        </Frame>
    
        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *"
          RowDefinitions="Auto, Auto"
          ColumnSpacing="10"
          RowSpacing="8">

                <!-- Cabeçalhos -->
                <Label Grid.Row="0" Grid.Column="0"
               Text="Check-in:"
               FontAttributes="Bold"
               FontSize="14"
               HorizontalTextAlignment="Center" />
                <Label Grid.Row="0" Grid.Column="1"
               Text="Check-out:"
               FontAttributes="Bold"
               FontSize="14"
               HorizontalTextAlignment="Center" />
                <Label Grid.Row="0" Grid.Column="2"
               Text="Dias de Estadia:"
               FontAttributes="Bold"
               FontSize="14"
               HorizontalTextAlignment="Center" />

                <!-- Valores -->
                <Label Grid.Row="1" Grid.Column="0"
               Text="{Binding CheckinFormatado}"
               FontSize="16"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Grid.Column="1"
               Text="{Binding CheckoutFormatado}"
               FontSize="16"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Grid.Column="2"
               Text="{Binding DiasEstadia}"
               FontSize="16"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

            </Grid>
        </Frame>

        <Frame Margin="10">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">

                <Label Text="Valor Total:"
               FontAttributes="Bold"
               FontSize="14"
               HorizontalTextAlignment="Center" />

                <Label Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}"
               FontSize="18"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Frame>

        <Grid ColumnDefinitions="*,*"
      Margin="20,10">

            <!-- Botão Voltar à esquerda -->
            <Button Grid.Column="0"
            Text="Voltar"
            Clicked="Button_Clicked"
            BackgroundColor="LightGray"
            TextColor="Black"
            FontAttributes="Bold"
            CornerRadius="8"
            Padding="12"
            HorizontalOptions="Start"
            WidthRequest="120" />

            <!-- Botão Confirmar à direita -->
            <Button Grid.Column="1"
            Text="Confirmar Reserva"
            Clicked="OnConfirmarReservaClicked"
            BackgroundColor="{StaticResource Primary}"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="8"
            Padding="12"
            HorizontalOptions="End"
            WidthRequest="160" />

        </Grid>

    </VerticalStackLayout>
</ContentPage>