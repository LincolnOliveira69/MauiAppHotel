<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.PaginaSobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="5">

            <!-- Título visual personalizado -->
            <Label Text="Sobre o Aplicativo"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,10" />

            <!-- Desenvolvedor -->
            <Label Text="👨‍💻 Desenvolvedor:"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black" />
            <Label Text="Lincoln César de Oliveira"
                   FontSize="18"
                   TextColor="Black" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,10" />

            <!-- Ano de Desenvolvimento -->
            <Label Text="📅 Ano de Desenvolvimento:"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black" />
            <Label Text="2025"
                   FontSize="18"
                   TextColor="Black" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,10" />

            <!-- Descrição do projeto -->
            <Label Text="📱 Aplicativo:"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black" />
            <Label Text="Este aplicativo foi desenvolvido com o objetivo de facilitar a contratação de hospedagens de forma prática e intuitiva. Utilizando a tecnologia .NET MAUI, ele oferece uma interface moderna e responsiva, permitindo ao usuário selecionar acomodações, definir o período da estadia e calcular valores com facilidade. O projeto foi idealizado para atender tanto usuários finais quanto gestores de hospedagem, com foco em simplicidade e eficiência."
                   FontSize="16"
                   TextColor="Black"
                   LineHeight="1.5"
                   HorizontalTextAlignment="Start" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>